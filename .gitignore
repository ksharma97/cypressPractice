# Ignore node_modules, which contains all the installed dependencies
node_modules/

# Ignore Cypress cache files
cypress/cache/

# Ignore Cypress screenshot files
cypress/screenshots/*

# Ignore Cypress video files
cypress/videos/*

# Ignore any environment variables file
.env
*.env.local

# Ignore log files
*.log

# Ignore report files
cypress/reports/*
mochawesome-report/
allure-results/
junit.xml

# Ignore any files generated by the OS
.DS_Store
Thumbs.db

# Ignore any coverage files
coverage/
